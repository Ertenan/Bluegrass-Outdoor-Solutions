NEXT_PUBLIC_COMPANY_PHONE=513-687-9089
NEXT_PUBLIC_CONTACT_EMAIL=tbethan21@gmail.com
NEXT_PUBLIC_SERVICE_AREA=Union, Florence, Northern Kentucky

# Static-safe form delivery options:
# 1. Web3Forms: keep this endpoint and set the public access key after restricting it to your domain.
NEXT_PUBLIC_QUOTE_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# 2. AWS Lambda/API Gateway relay: replace NEXT_PUBLIC_QUOTE_ENDPOINT with the relay URL.
# Never put SMTP credentials, AWS keys, or Turnstile secret keys in a Next.js static build.

NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
